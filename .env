# ---------------------------------------------------------------------------
# GharSe Tiffin - root environment file consumed by docker-compose.yml
# Copy to .env and edit as needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres (used by the `db` service and the backend)
POSTGRES_USER=tiffin
POSTGRES_PASSWORD=tiffin
POSTGRES_DB=gharse_tiffin

# Backend
# The backend builds this from the POSTGRES_* values by default; override only
# if you point at an external database.
DATABASE_URL=postgresql+psycopg://tiffin:tiffin@db:5432/gharse_tiffin
JWT_SECRET=change-me-in-production-please
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# IANA timezone the cutoff clock runs in.
APP_TIMEZONE=Asia/Kolkata
# Seed data on first boot: "full" (default) creates demo customers, subscriptions,
# skips, ad-hoc orders, and invoices. "minimal" seeds only menu/plans/service
# areas/site settings and leaves the customers table empty for real signups.
SEED_MODE=minimal

# ---- Frontend ---------------------------------------------------------------
# Base path the browser uses for API calls. Keep this RELATIVE ("/api/v1") so the
# browser calls whatever origin served the page — localhost, a LAN IP, or an
# ngrok / reverse-proxy URL — and the Next.js server proxies it to the backend.
# Only set an absolute URL if browsers should hit the backend directly (that
# backend must then list the site origin in CORS_ORIGINS).
NEXT_PUBLIC_API_BASE=/api/v1

# Where the Next.js server forwards /api/* (server-to-server, never seen by the
# browser). Baked into the frontend image at build time.
BACKEND_ORIGIN=http://backend:8000
