# Base URL the browser uses for API calls.
# Leave unset (or "/api/v1") to call this site's own origin and let the Next.js
# server proxy /api/* to the backend — this is what makes the app work behind
# ngrok / any tunnel. Only set an absolute URL to make browsers hit a backend
# directly (that backend must then allow this site's origin via CORS).
# NEXT_PUBLIC_API_BASE=/api/v1

# Where the Next.js server forwards /api/* (server-to-server, never seen by the
# browser). Defaults to http://localhost:8000 for `npm run dev`.
# BACKEND_ORIGIN=http://localhost:8000
